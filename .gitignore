# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node_modules

# cloudflare spike: local wrangler state and generated test payload
spikes/cf-pdf/.wrangler/
spikes/cf-pdf/payload.json
.wrangler/

# real newspaper sample PDF (large, and not ours to publish by default)
samples/*.pdf

# keep the documented example env file despite the .env* rule above
!.env.example
