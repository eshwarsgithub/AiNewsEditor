{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard (Workers Builds).
  "name": "ainewseditor",
  "main": "worker-entry.mjs",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // The self-reference must point at this same Worker's name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ainewseditor"
    }
  ],
  // Headless Chromium for layout + PDF.
  "browser": { "binding": "BROWSER", "remote": true },
  // Finished PDFs and page previews.
  "r2_buckets": [{ "binding": "OUT", "bucket_name": "ainewseditor-out" }],
  "keep_names": false,
  "observability": { "enabled": true }
}
